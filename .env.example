# StudySphere — Zero-Cost Environment Configuration
# No paid API keys, paid databases, or paid AI services are required.

# Server port (defaults to 3000)
PORT="3000"

# Public URL where the app is hosted (optional)
APP_URL="http://localhost:3000"

# Advertising switch — MUST remain "false" until owner approval and ad-network approval.
ADS_ENABLED="false"

# Local free-tier storage safeguard in bytes (default: 5 MB).
# Prevents unbounded disk growth; existing data is preserved if the cap is reached.
MAX_STORE_BYTES="5242880"

# --- Free database (Turso). Leave empty to keep using the local file store (fine for local development). ---
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Number of reverse proxies in front of the app (Render = 1). Used for correct visitor IPs.
TRUST_PROXY_HOPS="1"
# Set to "true" only if the site is served through Cloudflare.
TRUST_CLOUDFLARE="false"
